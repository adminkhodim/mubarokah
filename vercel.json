{
  "cleanUrls": true,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/berita/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/app",
      "destination": "/app"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app"
    },
    {
      "source": "/admin",
      "destination": "/app"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app"
    },
    {
      "source": "/administrator",
      "destination": "/app"
    },
    {
      "source": "/administrator/(.*)",
      "destination": "/app"
    },
    {
      "source": "/((?!assets/|css/|js/|api/|manifest\\.json|favicon\\.ico|sw\\.js|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index"
    }
  ]
}
