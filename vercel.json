{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/administrator",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/administrator/(.*)",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/berita/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/app",
      "destination": "/app"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app"
    },
    {
      "source": "/administrator",
      "destination": "/app"
    },
    {
      "source": "/administrator/(.*)",
      "destination": "/app"
    },
    {
      "source": "/admin",
      "destination": "/app"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app"
    },
    {
      "source": "/(.*)",
      "destination": "/index"
    }
  ]
}