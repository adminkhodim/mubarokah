{
  "name": "mubarokah-app",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi Pesantren Mubarokah",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/styles.min.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/styles.min.css --watch",
    "build": "npm run build:css",
    "backend:status": "cd legacy && clasp status",
    "backend:push": "cd legacy && clasp push -f",
    "backend:pull": "cd legacy && clasp pull"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
